{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ihat://identity/identity-provider-connection/v1",
  "title": "iHAT IdentityProviderConnection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "revision", "created_at", "updated_at", "digest",
    "connection_role", "provider_kind", "issuer", "discovery_uri", "client_id",
    "client_authentication", "redirect_uris", "allowed_audiences", "scopes",
    "automatic_email_linking", "key_set_digest", "status", "connected_at",
    "last_verified_at", "revocation_epoch"
  ],
  "properties": {
    "schema": { "const": "ihat://identity/identity-provider-connection/v1" },
    "id": { "type": "string", "pattern": "^provider-connection/[a-z0-9][a-z0-9._-]{0,126}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "digest": { "$ref": "#/$defs/digest" },
    "connection_role": { "enum": ["upstream-identity-provider", "relying-party-client"] },
    "provider_kind": { "enum": ["zitadel", "microsoft-entra", "generic-oidc"] },
    "issuer": { "$ref": "#/$defs/issuer" },
    "discovery_uri": { "$ref": "#/$defs/httpsUri" },
    "client_id": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^\\s]+$" },
    "client_authentication": { "enum": ["none-pkce", "private-key-jwt", "client-secret-brokered"] },
    "credential_reference": { "type": "string", "pattern": "^cred/[A-Za-z0-9._~-]{16,190}$" },
    "redirect_uris": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": { "$ref": "#/$defs/redirectUri" }
    },
    "allowed_audiences": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" }
    },
    "scopes": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "contains": { "const": "openid" },
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9._:-]{0,62}$" }
    },
    "automatic_email_linking": { "const": false },
    "key_set_digest": { "$ref": "#/$defs/digest" },
    "status": { "enum": ["configured", "active", "suspended", "disconnected"] },
    "connected_at": { "$ref": "#/$defs/timestamp" },
    "last_verified_at": { "$ref": "#/$defs/timestamp" },
    "revocation_epoch": { "type": "integer", "minimum": 0 }
  },
  "allOf": [
    {
      "if": { "properties": { "client_authentication": { "enum": ["private-key-jwt", "client-secret-brokered"] } }, "required": ["client_authentication"] },
      "then": { "required": ["credential_reference"] }
    }
  ],
  "$defs": {
    "timestamp": {
      "type": "string", "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "issuer": { "type": "string", "format": "uri", "pattern": "^https://[^?#*]{1,480}$" },
    "httpsUri": { "type": "string", "format": "uri", "pattern": "^https://[^#*]{1,480}$" },
    "redirectUri": {
      "type": "string", "format": "uri", "maxLength": 512,
      "pattern": "^(https://[^#*]+|http://127\\.0\\.0\\.1(?::[0-9]{1,5})?/[^#*]*)$"
    }
  }
}
