{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ihat://identity/step-up-evidence/v1",
  "title": "iHAT StepUpEvidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "revision", "created_at", "updated_at", "digest",
    "service_account_id", "pairwise_subject", "device_id", "workload_id", "actor_id",
    "issuer", "audience", "authentication_event_id", "authentication_methods",
    "assurance", "authenticated_at", "expires_at", "nonce_digest", "operation_digest",
    "provider_evidence_digest", "proof_key_thumbprint", "revocation_epoch"
  ],
  "properties": {
    "schema": { "const": "ihat://identity/step-up-evidence/v1" },
    "id": { "type": "string", "pattern": "^step-up/[a-z0-9][a-z0-9._-]{0,126}$" },
    "revision": { "type": "integer", "const": 1 },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "digest": { "$ref": "#/$defs/digest" },
    "service_account_id": { "type": "string", "pattern": "^service-account/[a-z0-9][a-z0-9._-]{0,126}$" },
    "pairwise_subject": { "type": "string", "minLength": 16, "maxLength": 255, "pattern": "^[A-Za-z0-9._~-]+$" },
    "device_id": { "type": "string", "pattern": "^device/[a-z0-9][a-z0-9._-]{0,126}$" },
    "workload_id": { "type": "string", "pattern": "^(spiffe://[A-Za-z0-9._/-]{3,240}|local-workload/[a-z0-9][a-z0-9._/-]{0,190})$" },
    "actor_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}/[a-z0-9][a-z0-9._-]{0,126}$" },
    "issuer": { "$ref": "#/$defs/issuer" },
    "audience": { "$ref": "#/$defs/serviceId" },
    "authentication_event_id": { "type": "string", "pattern": "^auth-event/[A-Za-z0-9._~-]{16,190}$" },
    "authentication_methods": {
      "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
      "items": { "enum": ["passkey", "fido2-security-key", "authenticator-push", "totp"] }
    },
    "assurance": { "enum": ["baseline", "phishing-resistant", "hardware-bound"] },
    "authenticated_at": { "$ref": "#/$defs/timestamp" },
    "expires_at": { "$ref": "#/$defs/timestamp" },
    "nonce_digest": { "$ref": "#/$defs/digest" },
    "operation_digest": { "$ref": "#/$defs/digest" },
    "provider_evidence_digest": { "$ref": "#/$defs/digest" },
    "proof_key_thumbprint": { "$ref": "#/$defs/digest" },
    "revocation_epoch": { "type": "integer", "minimum": 0 }
  },
  "allOf": [
    {
      "if": { "properties": { "assurance": { "enum": ["phishing-resistant", "hardware-bound"] } }, "required": ["assurance"] },
      "then": { "properties": { "authentication_methods": { "contains": { "enum": ["passkey", "fido2-security-key"] } } } }
    },
    {
      "if": { "properties": { "assurance": { "const": "hardware-bound" } }, "required": ["assurance"] },
      "then": { "properties": { "authentication_methods": { "contains": { "const": "fido2-security-key" } } } }
    }
  ],
  "$defs": {
    "timestamp": {
      "type": "string", "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "issuer": { "type": "string", "format": "uri", "pattern": "^https://[^?#]{1,480}$" },
    "serviceId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" }
  }
}
