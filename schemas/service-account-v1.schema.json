{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ihat://identity/service-account/v1",
  "title": "iHAT ServiceAccount v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "revision", "created_at", "updated_at", "digest",
    "service_id", "pairwise_subject", "roles", "status", "opened_at",
    "revocation_epoch"
  ],
  "properties": {
    "schema": { "const": "ihat://identity/service-account/v1" },
    "id": { "type": "string", "pattern": "^service-account/[a-z0-9][a-z0-9._-]{0,126}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "digest": { "$ref": "#/$defs/digest" },
    "service_id": { "$ref": "#/$defs/serviceId" },
    "pairwise_subject": { "$ref": "#/$defs/pairwiseSubject" },
    "roles": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,62}$" }
    },
    "status": { "enum": ["pending", "active", "suspended", "closed"] },
    "opened_at": { "$ref": "#/$defs/timestamp" },
    "closed_at": { "$ref": "#/$defs/timestamp" },
    "revocation_epoch": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "timestamp": {
      "type": "string", "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "serviceId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "pairwiseSubject": { "type": "string", "minLength": 16, "maxLength": 255, "pattern": "^[A-Za-z0-9._~-]+$" }
  }
}

