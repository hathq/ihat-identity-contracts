{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ihat://identity/user-session/v1",
  "title": "iHAT UserSession v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "revision", "created_at", "updated_at", "digest",
    "service_account_id", "device_id", "session_handle_digest", "broker_reference",
    "issuer", "audience", "assurance", "authentication_methods", "authenticated_at",
    "last_seen_at", "expires_at", "revocation_epoch", "status"
  ],
  "properties": {
    "schema": { "const": "ihat://identity/user-session/v1" },
    "id": { "type": "string", "pattern": "^session-record/[a-z0-9][a-z0-9._-]{0,126}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "digest": { "$ref": "#/$defs/digest" },
    "service_account_id": { "type": "string", "pattern": "^service-account/[a-z0-9][a-z0-9._-]{0,126}$" },
    "device_id": { "type": "string", "pattern": "^device/[a-z0-9][a-z0-9._-]{0,126}$" },
    "session_handle_digest": { "$ref": "#/$defs/digest" },
    "broker_reference": { "type": "string", "pattern": "^cred/[A-Za-z0-9._~-]{16,190}$" },
    "issuer": { "$ref": "#/$defs/issuer" },
    "audience": { "$ref": "#/$defs/serviceId" },
    "assurance": { "enum": ["baseline", "phishing-resistant", "hardware-bound"] },
    "authentication_methods": {
      "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": { "enum": ["passkey", "fido2-security-key", "authenticator-push", "totp"] }
    },
    "authenticated_at": { "$ref": "#/$defs/timestamp" },
    "last_seen_at": { "$ref": "#/$defs/timestamp" },
    "expires_at": { "$ref": "#/$defs/timestamp" },
    "revocation_epoch": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["active", "expired", "revoked"] }
  },
  "allOf": [
    {
      "if": { "properties": { "assurance": { "enum": ["phishing-resistant", "hardware-bound"] } }, "required": ["assurance"] },
      "then": { "properties": { "authentication_methods": { "contains": { "enum": ["passkey", "fido2-security-key"] } } } }
    }
  ],
  "$defs": {
    "timestamp": {
      "type": "string", "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "serviceId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "issuer": { "type": "string", "format": "uri", "pattern": "^https://[^?#]{1,480}$" }
  }
}

