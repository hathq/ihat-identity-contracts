{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ihat://identity/account-recovery/v1",
  "title": "iHAT AccountRecovery v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "revision", "created_at", "updated_at", "digest",
    "subject_id", "recovery_method", "authority_references", "target_authenticator_ids",
    "ceremony_digest", "initiated_at", "expires_at", "status", "revocation_epoch"
  ],
  "properties": {
    "schema": { "const": "ihat://identity/account-recovery/v1" },
    "id": { "type": "string", "pattern": "^recovery/[a-z0-9][a-z0-9._-]{0,126}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "digest": { "$ref": "#/$defs/digest" },
    "subject_id": { "type": "string", "pattern": "^subject/[a-z0-9][a-z0-9._-]{0,126}$" },
    "recovery_method": { "enum": ["mnemonic-seed-and-bound-authenticator", "independent-passkeys", "offline-recovery-authorities", "admin-assisted-dual-control"] },
    "authority_references": {
      "type": "array", "minItems": 2, "maxItems": 4, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^recovery-authority/[A-Za-z0-9._~-]{16,190}$" }
    },
    "target_authenticator_ids": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^authenticator/[a-z0-9][a-z0-9._-]{0,126}$" }
    },
    "ceremony_digest": { "$ref": "#/$defs/digest" },
    "initiated_at": { "$ref": "#/$defs/timestamp" },
    "expires_at": { "$ref": "#/$defs/timestamp" },
    "approved_at": { "$ref": "#/$defs/timestamp" },
    "completed_at": { "$ref": "#/$defs/timestamp" },
    "status": { "enum": ["initiated", "verified", "approved", "completed", "cancelled", "expired"] },
    "revocation_epoch": { "type": "integer", "minimum": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
      "then": { "required": ["approved_at", "completed_at"] }
    }
  ],
  "$defs": {
    "timestamp": {
      "type": "string", "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
