{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ihat://identity/registered-device/v1",
  "title": "iHAT RegisteredDevice v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "revision", "created_at", "updated_at", "digest",
    "service_account_id", "display_name", "platform", "device_key_thumbprint",
    "credential_reference", "proof_method", "attestation", "trust_status",
    "registered_at", "last_seen_at", "revocation_epoch"
  ],
  "properties": {
    "schema": { "const": "ihat://identity/registered-device/v1" },
    "id": { "type": "string", "pattern": "^device/[a-z0-9][a-z0-9._-]{0,126}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "digest": { "$ref": "#/$defs/digest" },
    "service_account_id": { "type": "string", "pattern": "^service-account/[a-z0-9][a-z0-9._-]{0,126}$" },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\r\\n]+$" },
    "platform": { "enum": ["windows", "macos", "linux", "ios", "android", "other"] },
    "device_key_thumbprint": { "$ref": "#/$defs/digest" },
    "credential_reference": { "$ref": "#/$defs/opaqueReference" },
    "proof_method": { "enum": ["dpop", "local-sender-proof"] },
    "attestation": { "enum": ["none", "self", "managed", "hardware-verified"] },
    "trust_status": { "enum": ["pending", "trusted", "suspended", "revoked"] },
    "registered_at": { "$ref": "#/$defs/timestamp" },
    "last_seen_at": { "$ref": "#/$defs/timestamp" },
    "revocation_epoch": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "timestamp": {
      "type": "string", "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "opaqueReference": { "type": "string", "pattern": "^cred/[A-Za-z0-9._~-]{16,190}$" }
  }
}

